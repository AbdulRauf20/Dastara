# ============================================================================
# DASTARA — Environment Configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` for local development and set the real values.
# NEVER commit `.env.local` or any file containing real secrets.
# In production (Vercel), configure these in Project Settings → Environment
# Variables.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Supabase Dashboard → Project Settings → Data API / API Keys
# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key. Safe to expose to the browser. Protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER-ONLY. Bypasses RLS. NEVER expose to the browser,
# never prefix with NEXT_PUBLIC_, never commit. Used only in trusted server
# code (e.g. admin user provisioning, privileged maintenance scripts).
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -------------------------------------------------------------------
# Public canonical URL of the deployed site (used for SEO, sitemap, OG, and
# absolute links). Local: http://localhost:3000  Prod: https://dastara.pk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp (optional fallback) ------------------------------------------
# The business WhatsApp number is primarily managed from the admin Settings
# page (stored in the database). This value is only used as a bootstrap
# fallback before settings are configured. International format, digits only,
# no "+" and no leading zeros. Example for Pakistan 0345 3412201 => 923453412201
NEXT_PUBLIC_WHATSAPP_FALLBACK=923453412201
